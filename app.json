{
  "expo": {
    "name": "Restaurante El Quijote",
    "slug": "restaurant-management-mobile",
    "owner": "ij-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ijstudio.restaurantmanagement"
    },
    "android": {
      "package": "quijote.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#14100C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "jose-6r",
          "project": "react-native"
        }
      ],
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#e85d04"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keepattributes SourceFile,LineNumberTable\n-renamesourcefileattribute SourceFile"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c63e0e6d-265d-42d1-ac04-5ff93777dba7"
      }
    }
  }
}
