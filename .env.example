# Copia este archivo como .env y llena los valores. El .env NO se sube a Git.
# Solo nombres: nunca escribas valores reales aquí.

# --- App (las EXPO_PUBLIC_* quedan dentro del bundle: nunca pongas secretos en ellas) ---
# URL base de restaurant-management-api. En builds de preview/producción debe ser HTTPS.
EXPO_PUBLIC_API_URL=
# DSN del proyecto en Sentry (Settings > Projects > Client Keys). Vacío = Sentry apagado.
EXPO_PUBLIC_SENTRY_DSN=
# Web pública (páginas de privacidad y eliminar cuenta). Vacío = https://el-quijote.vercel.app
EXPO_PUBLIC_WEB_URL=

# --- Solo para builds (EAS / CI): súbelo como secreto, nunca al repositorio ---
# Permite subir los source maps a Sentry.
# SENTRY_AUTH_TOKEN=

# --- Pruebas ---
# URL del API real local (copia de la BD, nunca producción) para las pruebas *.real.test.
# Normalmente http://127.0.0.1:4100. Vacío = esas pruebas se omiten.
# E2E_API_REAL=

# Llave PÚBLICA de Stripe (pk_test_… en pruebas). Nunca la secreta (sk_…): termina en el APK.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Obligatorio: el fetch de React Native (no el de Expo) para que el certificate pinning cubra las
# peticiones al API (ver src/core/http/certificatePinning.ts).
EXPO_PUBLIC_USE_RN_FETCH=1
