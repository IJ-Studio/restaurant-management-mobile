{
  "name": "restaurant-management-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/ibarra-real-nova": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/react-query": "^5.104.2",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-dev-client": "~58.0.17",
    "expo-font": "~58.0.11",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "audit-ci": "^7.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "jest-junit": "^16.0.0",
    "jscpd": "^5.4.1",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.2.3",
    "reassure": "^1.6.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.{js,ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.{js,ts,tsx}\"",
    "audit": "audit-ci --config audit-ci.jsonc",
    "duplication": "jscpd",
    "test:unit": "jest --testPathIgnorePatterns /node_modules/ \"\\.integration\\.test\\.\" \"\\.acceptance\\.test\\.\" \"\\.stress\\.test\\.\"",
    "test:integration": "jest --testPathPattern \"\\.integration\\.test\\.\" --coverage=false",
    "test:acceptance": "jest --config jest.acceptance.config.js",
    "test:perf": "reassure",
    "test:stress": "node --expose-gc node_modules/jest/bin/jest.js --config jest.stress.config.js --runInBand"
  },
  "private": true
}
